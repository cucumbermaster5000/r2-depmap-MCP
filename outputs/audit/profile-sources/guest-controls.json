  "scripts": [
    "window.r2 = {\"assetsBaseUrl\":\"https://hgserver1.amc.nl/r2/assets/v393/\"};",
    "",
    "",
    "import('https://hgserver1.amc.nl/r2/assets/v393/js/src/component/progressIndicator.js')",
    "\n        requirejs(['jquery', 'jqx-all'], function ($) {\n            $(\"#jqxMenu\").jqxMenu({ width: '160', mode: 'vertical', theme: 'base_r2' });\n            $(\"#jqxMenu\").css('visibility', 'visible');\n        })\n    ",
    "\n        if (window.document.documentMode) {\n            alert('R2 may not function properly in Internet Explorer. Please consider switching to a modern browser.');\n        }\n        document.getElementById('trainingAndCitations').hidden = false;\n    ",
    "import('https://hgserver1.amc.nl/r2/assets/v393/js/src/utils/setFetchedHTML.js').then(m => m['default']({\"selector\":\"#sample_counter\",\"data\":{\"ajaxoption\":\"ajax_count_samples\"}}));",
    "import('https://hgserver1.amc.nl/r2/assets/v393/js/src/datasetSelectionModal.js').then(m => m['default']({\"filterDatasets\":null,\"inputId\":\"table-dataset_table_input\",\"multiple\":null}));",
    "\n        document.forms['main_page_form'].elements['table'].addEventListener('change', function () {\n            import('https://hgserver1.amc.nl/r2/assets/v393/js/src/utils/requestPage.js').then(m => m.default({data: {'table': this.value}}));\n        });\n    ",
    "import('https://hgserver1.amc.nl/r2/assets/v393/js/src/component/jquerySlider.js').then(m => m['default']({\"width\":160,\"height\":160,\"containerId\":\"slides\"}));",
    "import('https://hgserver1.amc.nl/r2/assets/v393/js/src/main.js')"
  ]
